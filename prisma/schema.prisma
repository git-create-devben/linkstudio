generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model User {
  id                  String        @id @default(uuid())
  email               String        @unique
  supabaseId          String        @unique @map("supabase_id")
  onboardingCompleted Boolean       @default(false)
  onboardingStep      Int           @default(0)
  platforms           String[]
  username            String?       @unique
  goal                String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  profile             Profile?      @relation("ProfileToUser")
  socialLinks         SocialLinks[]
  webLinks            WebLink[]
  payments            Payment[]
  subscriptionId      String?
  isActive            Boolean       @default(false)
  plan                String?
  billingCycle        String?
  payment_gateway     String?

  @@map("users")
}

model Profile {
  id              String       @id @default(uuid())
  userId          String       @unique
  profileImageUrl String?
  displayName     String?
  bio             String?
  templateId      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  pageViews       Int          @default(0)
  template        Template?    @relation(fields: [templateId], references: [id])
  user            User         @relation("ProfileToUser", fields: [userId], references: [id], onDelete: Cascade)
  actionItems     ActionItem[]
  Actions         Actions?
  content         Content?
  design          Design?
}

model Template {
  id          String    @id @default(uuid())
  name        String?
  description String?
  profiles    Profile[]

  @@map("templates")
}

model ActionItem {
  id        String   @id @default(uuid())
  profileId String
  type      String
  config    Json
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clicks    Int      @default(0)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("action_items")
}

model Content {
  id                  String  @id @default(uuid())
  profileId           String  @unique
  profilePicture      String?
  profileName         String?
  profileBio          String?
  coverImage          String?
  profileVerified     Boolean @default(false)
  verifiedBadgeStyle  String? @default("music")
  profile             Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("contents")
}

model Design {
  id                String  @id @default(uuid())
  profileId         String  @unique
  // Theme and Layout
  theme             String? @default("dark") // light, dark, glassmorphic
  layout            String?
  font              String? @default("Inter")
  
  // Background customization
  customBackground  String? // Custom gradient or color for main background
  
  // Banner/Curve system
  bannerType        String? @default("none") // none, image, curve
  bannerValue       String? // URL for image or gradient for curve
  bannerHeight      Int?    @default(200)
  bannerOpacity     Float?  @default(1.0)
  bannerBlur        Boolean @default(false)
  curveShape        String? // wave, mountains, arch, etc.
  curveColor        String? // Independent curve color/gradient
  curveAnimated     Boolean @default(true)
  
  // Text customization
  textPrimaryColor   String? // Primary text color override
  textSecondaryColor String? // Secondary text color override
  textAlignment      String? @default("center") // left, center, right
  
  // Button customization
  buttonStyle        String? @default("default") // default, rounded, square, pill
  buttonColor        String? // Button background color
  buttonTextColor    String? // Button text color
  buttonBorderColor  String? // Button border color
  buttonHoverColor   String? // Button hover color
  buttonShadow       Boolean @default(true)
  buttonAnimation    String? @default("scale") // scale, slide, glow, none
  
  // Card/Container styling
  cardStyle          String? @default("glass") // glass, solid, outline, minimal
  cardBorderRadius   Int?    @default(12) // Border radius in pixels
  cardShadow         Boolean @default(true)
  cardBlur           Boolean @default(true)
  
  // Animation preferences
  reducedMotion      Boolean @default(false)
  animationSpeed     String? @default("normal") // slow, normal, fast
  
  // Enhanced styling options
  profileImageStyle  String? @default("circle") // circle, rounded, square
  profileImageBorder Boolean @default(false)
  profileImageShadow Boolean @default(true)
  socialLinksStyle   String? @default("pills") // pills, circles, squares, minimal
  socialLinksAnimation String? @default("hover") // hover, pulse, bounce, none
  spacing            String? @default("normal") // compact, normal, relaxed
  borderRadius       String? @default("medium") // none, small, medium, large
  shadowIntensity    String? @default("medium") // none, subtle, medium, strong
  
  // Legacy fields (for backward compatibility)
  background         String?
  color              String?
  bottomStyles       Json?
  
  profile            Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("designs")
}

model Actions {
  id         String  @id @default(uuid())
  profileId  String  @unique
  layoutType String?
  config     Json?
  profile    Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("actions")
}

model SocialLinks {
  id     String @id @default(uuid())
  userId String
  name   String
  url    String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("socialLinks")
}

model WebLink {
  id     String @id @default(uuid())
  userId String
  title  String
  url    String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("web_links")
}

model Payment {
  id            String   @id @default(uuid())
  userId        String
  reference     String   @unique
  amount        Int
  status        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
}